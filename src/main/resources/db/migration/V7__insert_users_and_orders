-- Crea usuarios con NEWID() y los asigna a carritos y órdenes
-- Fecha: 2025-07-17
-- Autor: Juan

-- 👤 Crear tabla temporal para capturar los IDs generados
DECLARE @UserIds TABLE (
    user_id UNIQUEIDENTIFIER,
    label NVARCHAR(50)
);

-- 👤 Insertar usuarios y guardar sus IDs
INSERT INTO users (id, name, email, password)
OUTPUT inserted.id, 'Juan' INTO @UserIds(user_id, label)
VALUES (NEWID(), 'Juan Pérez', 'juan.new@example.com', 'hashed_pw_juan');

INSERT INTO users (id, name, email, password)
OUTPUT inserted.id, 'Ana' INTO @UserIds(user_id, label)
VALUES (NEWID(), 'Ana Gómez', 'ana.new@example.com', 'hashed_pw_ana');

INSERT INTO users (id, name, email, password)
OUTPUT inserted.id, 'Carlos' INTO @UserIds(user_id, label)
VALUES (NEWID(), 'Carlos Ruiz', 'carlos.new@example.com', 'hashed_pw_carlos');

-- 🛒 Crear carritos para cada usuario
INSERT INTO carts (id, user_id, date_created)
SELECT NEWID(), user_id, GETDATE() FROM @UserIds WHERE label = 'Juan';

INSERT INTO carts (id, user_id, date_created)
SELECT NEWID(), user_id, DATEADD(DAY, -1, GETDATE()) FROM @UserIds WHERE label = 'Ana';

INSERT INTO carts (id, user_id, date_created)
SELECT NEWID(), user_id, DATEADD(DAY, -2, GETDATE()) FROM @UserIds WHERE label = 'Carlos';

-- 🧾 Crear órdenes para cada usuario
INSERT INTO orders (id, customer_id, status, created_at, total_price)
SELECT NEWID(), user_id, 'PENDING', GETDATE(), 129.99 FROM @UserIds WHERE label = 'Juan';

INSERT INTO orders (id, customer_id, status, created_at, total_price)
SELECT NEWID(), user_id, 'SHIPPED', DATEADD(DAY, -1, GETDATE()), 89.50 FROM @UserIds WHERE label = 'Ana';

INSERT INTO orders (id, customer_id, status, created_at, total_price)
SELECT NEWID(), user_id, 'DELIVERED', DATEADD(DAY, -2, GETDATE()), 210.00 FROM @UserIds WHERE label = 'Carlos';